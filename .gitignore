# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/

# next.js
/.next/
/out/
/build/

# testing reports (generated artifacts only — the test suites + their config
# files ARE committed so CI and contributors can run them)
/coverage/
/playwright-report/
/test-results/
/html-report/
/blob-report/
/.nyc_output/

# generated analysis output (codemap diffs, audit scratch)
/.reports/

# env files and local secrets
.env
.env.*
# ...but a committed template is how contributors learn which vars exist.
# Without these negations `.env.*` above silently swallows them.
!.env.example
!.env.template
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.tmekey
*.tmebak
secrets.*

# local app data and generated exports
/uploads/
/exports/
/backups/
*.sqlite
*.sqlite3
*.db
*.db-journal

# local tool config
.agents/
.vercel/
.claude/settings.local.json
.claude/skills/
.codex/local.*
.codex/*.local.*

# docs: default-private, with contributor-facing pages explicitly opted in.
# A fork is MIT and self-hostable, so the docs a contributor actually needs to
# build (architecture, design tokens, feature map, provider setup) ship with
# the code; internal planning/audit scratch stays local.
/docs/*
!/docs/ARCHITECTURE.md
!/docs/PROJECT_INDEX.md
!/docs/FEATURES.md
!/docs/DESIGN_SYSTEM.md
!/docs/PROVIDERS.md
!/docs/PROVIDERS_LOCAL.md
!/docs/README.md
!/docs/STATIC_EXPORT_WORKSPACE_ROUTING.md
# Negating a directory needs the dir itself un-ignored before its contents
# can match — `!/docs/CODEMAPS/**` alone would never be reached.
!/docs/CODEMAPS/
!/docs/CODEMAPS/**

# project notes not intended for git
/legacy/
/AGENTS.md

# npm/package-manager local artifacts
# (Yarn Berry dirs are already covered by the `.yarn/*` block at the top —
# repeating cache/unplugged/build-state/install-state here was redundant.)
/.npm/
/.npmrc.local
/.npmrc.*.local
/.pnpm-store/
/.parcel-cache/
/.turbo/

# logs and diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.log

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
# Windows reserved name — accidentally created when a tool redirects to `nul`
# in cmd/PowerShell; Turbopack panics trying to read it on Windows.
/nul
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# typescript
*.tsbuildinfo
next-env.d.ts

# tauri (Phase 7+)
/src-tauri/target/
/src-tauri/gen/
/src-tauri/WixTools/
